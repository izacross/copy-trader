# Local development secrets (copy to .dev.vars). In production use: npx wrangler secret put <NAME>
INVO_REFRESH_TOKEN=eyJ...
# Optional in dry run (market data is public). Needed for live trading.
COINBASE_API_KEY_NAME=organizations/.../apiKeys/...
COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
# Optional: Slack incoming webhook for alerts.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
