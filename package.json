{
  "name": "copy-trader",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev --var DEV_ALLOW_UNAUTHENTICATED:true",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply copy-trader --remote",
    "db:migrate:local": "wrangler d1 migrations apply copy-trader --local",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  },
  "private": true
}
